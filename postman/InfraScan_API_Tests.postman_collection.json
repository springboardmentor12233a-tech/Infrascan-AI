      ]
    },
    {
      "name": "Inspections and analysis",
      "item": [
        {
          "name": "Inspector creates an inspection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{inspector_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/inspections/",
            "description": "Uses the asset created above. The inspector must assign it to themselves.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_id\": {{asset_id}},\n  \"inspector_id\": {{inspector_user_id}},\n  \"inspection_date\": \"2026-11-18\",\n  \"notes\": \"Milestone 4 API inspection\",\n  \"status\": \"pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"inspection created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"inspection is pending and assigned to the inspector\", function () {",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(body.status).to.eql(\"pending\");",
                  "  pm.expect(String(body.inspector_id)).to.eql(String(pm.collectionVariables.get(\"inspector_user_id\")));",
                  "  pm.expect(body.notes).to.eql(\"Milestone 4 API inspection\");",
                  "});",
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "saveVar(\"inspection_id\", String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inspector cannot assign another user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{inspector_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/inspections/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset_id\": {{asset_id}},\n  \"inspector_id\": {{manager_user_id}},\n  \"inspection_date\": \"2026-11-18\",\n  \"notes\": \"Should be rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve the inspection",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{inspector_token}}"
              }
            ],
            "url": "{{base_url}}/inspections/{{inspection_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
