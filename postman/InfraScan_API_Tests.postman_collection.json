    {
      "name": "Assets",
      "item": [
        {
          "name": "Manager creates an asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/assets/",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"asset_code\": \"{{asset_code}}\", \"name\": \"Postman Milestone Asset\", \"type\": \"Bridge\", \"location_text\": \"API test site\", \"latitude\": 12.97, \"longitude\": 77.59, \"construction_year\": 2001}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = \"PM-\" + Date.now();",
                  "pm.collectionVariables.set(\"asset_code\", code);",
                  "try { pm.environment.set(\"asset_code\", code); } catch (error) {}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"asset created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"asset payload has id and code\", function () {",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(body.asset_code).to.eql(pm.collectionVariables.get(\"asset_code\"));",
                  "  pm.expect(body.name).to.eql(\"Postman Milestone Asset\");",
                  "  pm.expect(body).to.not.have.property(\"password\");",
                  "});",
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "saveVar(\"asset_id\", String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager retrieves the asset",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              }
            ],
            "url": "{{base_url}}/assets/{{asset_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"retrieved asset matches\", function () {",
                  "  pm.expect(pm.response.json().asset_code).to.eql(pm.collectionVariables.get(\"asset_code\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager updates the asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/assets/{{asset_id}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"location_text\":\"API test site, updated\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"location updated\", function () {",
                  "  pm.expect(pm.response.json().location_text).to.eql(\"API test site, updated\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Persistence re-read",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{inspector_token}}"
              }
            ],
            "url": "{{base_url}}/assets/{{asset_id}}",
            "description": "A later read still returns the updated location."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"updated location persisted\", function () {",
                  "  pm.expect(pm.response.json().location_text).to.eql(\"API test site, updated\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager creates a disposable asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manager_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/assets/",
