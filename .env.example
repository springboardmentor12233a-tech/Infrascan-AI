# InfraScan Civil Infrastructure AI Platform - Environment Configuration

# Security & Authentication
SECRET_KEY=infrascan-dev-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite absolute database
DATABASE_URL=sqlite:///./infrascan.db
# PostgreSQL option:
# DATABASE_URL=postgresql://infrascan_user:infrascan_pass@localhost:5432/infrascan_db

# File Storage Paths
UPLOAD_PATH=./uploads
REPORTS_PATH=./reports
ANALYSIS_PATH=./analysis

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Inference Settings
YOLO_MODEL_PATH=./ml/weights/best_yolo.pt
UNET_MODEL_PATH=./ml/weights/best_unet.pth
CONFIDENCE_THRESHOLD=0.40
DEFAULT_CALIBRATION_SCALE_MM_PER_PX=0.25
