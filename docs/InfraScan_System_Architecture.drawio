        <!-- Frontend SPA -->
        <mxCell id="box-frontend" value="React 18 SPA (Vite + TailwindCSS)&#xa;• AuthContext (JWT State &amp; RBAC Guard)&#xa;• User &amp; Admin Dashboards&#xa;• New Inspection Upload &amp; Detail View&#xa;• Geospatial Damage Map (Leaflet)&#xa;• AI Model Evaluation &amp; Benchmarks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- Backend API -->
        <mxCell id="box-backend" value="FastAPI Backend Services (Python 3.11/3.13)&#xa;• Security: Passlib (Bcrypt) + PyJWT (24h TTL)&#xa;• /api/auth (Login, Register, Profile)&#xa;• /api/inspections (Upload, Detail, Reports)&#xa;• /api/admin (User Mgmt, System Oversight)&#xa;• /api/dashboard &amp; /api/analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="1">
