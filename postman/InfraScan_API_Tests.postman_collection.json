                "value": "Bearer {{manager_token}}"
              }
            ],
            "url": "{{base_url}}/assets/{{delete_asset_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
