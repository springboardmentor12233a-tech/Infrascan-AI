# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
backend/venv/
backend/.venv/

# ── Environment secrets – NEVER commit these ──────────────────────────────────
backend/.env
frontend/.env
.env
*.env.local

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/infrascan.db

# ── Uploaded images ───────────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing / Coverage / Logs ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.log

# Dataset archives and images - NEVER commit these
datasets/raw/**
!datasets/raw/**/
!datasets/raw/.gitkeep
!datasets/raw/**/README.md
# Nested CrackForest git clone; do not add as a gitlink
datasets/raw/cfd/
datasets/processed/**
!datasets/processed/**/
!datasets/processed/.gitkeep
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Copied EDA sample images (duplicates of raw photographs)
docs/eda_outputs/samples/

# Local EDA caches
.eda_cache/
