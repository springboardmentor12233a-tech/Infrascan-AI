# Copy this file to backend/.env and replace the placeholders.
# backend/.env is gitignored. Do not commit real secrets.
# Start uvicorn from the backend directory so this file is picked up.

APP_NAME=InfraScan
DEBUG=false

# This PC uses SQLite. Docker PostgreSQL is optional and was not started here.
DATABASE_URL=sqlite:///./infrascan.db
# DATABASE_URL=postgresql://infrascan:infrascan_pass@localhost:5432/infrascan_db

# Required before any shared or public deployment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64
BLUR_THRESHOLD=100.0
BRIGHTNESS_THRESHOLD=50.0

# The API also allows http://localhost:5173 and http://127.0.0.1:5173.
FRONTEND_URL=http://127.0.0.1:5173

# Google sign-in is not implemented. Leave these empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
