{
  "info": {
    "name": "InfraScan API Tests",
    "description": "Milestone 4 API checks for the running InfraScan FastAPI app. Set demo_password and sample_image in the environment before running. Do not commit real passwords or access tokens. Bearer tokens are used because the API authenticates with OAuth2PasswordBearer. Expired-token signing is covered by backend/tests/test_milestone3.py, because a Postman request cannot sign a token without the server secret. Detection may return status completed with reliable=false and an empty detections list. That is the honest YOLO result and is a passing assertion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "inspector_email",
      "value": "inspector@infrascan.com"
    },
    {
      "key": "manager_email",
      "value": "manager@infrascan.com"
    },
    {
      "key": "demo_password",
      "value": ""
    },
    {
      "key": "sample_image",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "inspector_token",
      "value": ""
    },
    {
      "key": "manager_token",
      "value": ""
    },
    {
      "key": "inspector_user_id",
      "value": ""
    },
    {
      "key": "manager_user_id",
      "value": ""
    },
    {
      "key": "asset_code",
      "value": ""
    },
    {
      "key": "asset_id",
      "value": ""
    },
    {
      "key": "delete_asset_id",
      "value": ""
    },
    {
      "key": "inspection_id",
      "value": ""
    },
    {
      "key": "image_id",
      "value": ""
    },
    {
      "key": "existing_asset_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Public liveness check."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"health payload\", function () {",
                  "  pm.expect(body.status).to.eql(\"ok\");",
                  "  pm.expect(body.app).to.eql(\"InfraScan\");",
                  "  pm.expect(body.version).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Inspector login and JWT",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/login",
            "description": "OAuth2 password form. Saves the inspector token into collection variables.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{inspector_email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{demo_password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"inspector login returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"JWT access token is present and not logged\", function () {",
                  "  pm.expect(body.token_type).to.eql(\"bearer\");",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.user.role.name).to.eql(\"Infrastructure Inspector\");",
                  "  pm.expect(body.user).to.not.have.property(\"password\");",
                  "  pm.expect(body.user).to.not.have.property(\"password_hash\");",
                  "});",
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "saveVar(\"inspector_token\", body.access_token);",
                  "saveVar(\"access_token\", body.access_token);",
                  "saveVar(\"inspector_user_id\", String(body.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid login",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/login",
            "description": "Unknown account. Uses a fake password, not a real one.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "nobody@infrascan.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "wrong-password",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"login error is a message, not a token\", function () {",
                  "  pm.expect(pm.response.json().detail).to.be.a(\"string\");",
                  "  pm.expect(pm.response.json()).to.not.have.property(\"access_token\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager login and JWT",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/auth/login",
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{manager_email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{demo_password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"manager login returns 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"manager JWT contains the manager role\", function () {",
                  "  pm.expect(body.token_type).to.eql(\"bearer\");",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.user.role.name).to.eql(\"Infrastructure Manager\");",
                  "});",
                  "function saveVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  try { pm.environment.set(key, value); } catch (error) {}",
                  "}",
                  "saveVar(\"manager_token\", body.access_token);",
                  "saveVar(\"manager_user_id\", String(body.user.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Authenticated profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{inspector_token}}"
              }
            ],
            "url": "{{base_url}}/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"profile matches the inspector\", function () {",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get(\"inspector_email\") || pm.environment.get(\"inspector_email\"));",
                  "  pm.expect(body.role.name).to.eql(\"Infrastructure Inspector\");",
                  "  pm.expect(body.is_active).to.eql(true);",
                  "  pm.expect(body).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing token is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me",
            "description": "No Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid token is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-valid-token"
              }
            ],
            "url": "{{base_url}}/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"invalid token detail\", function () {",
                  "  pm.expect(pm.response.json().detail).to.eql(\"Could not validate credentials\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
