# ─────────────────────────────────────────────────────────────────────────────
# InfraScan – Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="InfraScan"
DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Use the PostgreSQL URL when Docker is running:
DATABASE_URL=postgresql://infrascan:infrascan_pass@localhost:5432/infrascan_db
# Use the line below instead if you want to run WITHOUT Docker (SQLite):
# DATABASE_URL=sqlite:///./infrascan.db

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_use_a_strong_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Image Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MIN_IMAGE_WIDTH=64
MIN_IMAGE_HEIGHT=64

# ── Image Quality Thresholds ──────────────────────────────────────────────────
BLUR_THRESHOLD=100.0       # variance of Laplacian; below this = blurry
BRIGHTNESS_THRESHOLD=50.0  # mean gray; below this = low_light

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (stub – not implemented yet) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
