# InfraScan Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# DO NOT commit real .env files, production passwords, or secret keys into version control.

# Application Environment Mode: 'development' or 'production'
# In 'production', a valid non-placeholder INFRASCAN_JWT_SECRET of >= 32 characters is strictly required.
INFRASCAN_ENV=development

# JSON Web Token Secret Key
# ------------------------------------------------------------------------------
# MANDATORY for production deployments (minimum 32 characters).
# The placeholder below will INTENTIONALLY FAIL startup if left unchanged in production mode.
#
# Generate a cryptographically secure random key using one of the following commands:
#   Python:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   OpenSSL: openssl rand -hex 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# ------------------------------------------------------------------------------
INFRASCAN_JWT_SECRET=CHANGEME_GENERATE_A_SECURE_RANDOM_SECRET_KEY

# Storage Directories & Database Path (Configured for container volume mounts)
INFRASCAN_STORAGE_DIR=/app/data
INFRASCAN_DB_PATH=/app/data/infrascan.db
INFRASCAN_UPLOAD_DIR=/app/data/uploads
INFRASCAN_RESULTS_DIR=/app/data/results
INFRASCAN_REPORTS_DIR=/app/data/reports
INFRASCAN_MODELS_DIR=/app/models

# Backend Service Configuration
INFRASCAN_BACKEND_HOST=0.0.0.0
INFRASCAN_BACKEND_PORT=8000
